DISCORD_TOKEN=coloque_seu_token_do_discord_aqui
OPENROUTER_API_KEY=coloque_sua_api_key_do_openrouter_aqui

# API key da fastCRW (fastcrw.com) usada para busca/leitura de paginas na internet.
# So vale quando SEARXNG_URL esta vazio.
CRW_API_KEY=coloque_sua_api_key_da_fastcrw_aqui

# SearXNG proprio. No docker-compose.yml, vazio = http://searxng:8080 (o searxng da
# propria stack). Com ele, o web_search usa o SearXNG e o fetch_page le a pagina no
# proprio bot, sem o fastCRW e sem chave. Sem Docker, deixe vazio para usar o fastCRW
# ou aponte para um SearXNG seu com `json` habilitado em search.formats.
SEARXNG_URL=

# Modelo padrao (gratuito, texto). Pode trocar por outro terminado em ":free" do OpenRouter.
OPENROUTER_MODEL=poolside/laguna-s-2.1:free

# Modelo para imagens (vision). O id tem que ser valido no endpoint escolhido em
# VISION_API_BASE mais abaixo - no OpenRouter (padrao) e "autor/modelo:free", no
# Gemini e "gemini-3.5-flash-lite", no Ollama e o nome puxado com `ollama pull`.
# O nome antigo OPENROUTER_VISION_MODEL continua sendo aceito.
VISION_MODEL=thinkingmachines/inkling-small:free

# Modelos de fallback, em ordem, usados quando o principal falha (rate limit, erro
# HTTP, resposta vazia). Com modelo ":free" isso importa bastante: sem fallback, um
# unico 429 ja vira "nao consegui responder". Todos precisam suportar tool calling,
# porque o bot manda as ferramentas em toda chamada.
#
# Vale colocar aqui modelos free maiores que o principal: alem de cobrir a falha, a
# resposta que vem deles costuma ser melhor. Ids de modelo free mudam com frequencia
# no OpenRouter - confira em openrouter.ai/models (filtro de preco: free) se um deles
# parar de funcionar. Deixando a linha comentada, vale a lista padrao do codigo.
OPENROUTER_FALLBACK_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free,nvidia/nemotron-3-super-120b-a12b:free,google/gemma-4-31b-it:free,thinkingmachines/inkling:free,nvidia/nemotron-3.5-lightning:free,poolside/laguna-xs-2.1:free,google/gemma-4-26b-a4b-it:free,cohere/north-mini-code:free

# Google AI Studio (Gemini) como ultimo recurso: se o principal e todos os fallbacks acima
# falharem, o bot tenta estes modelos, que tem cota propria. Chave gratuita em
# aistudio.google.com/apikey. Precisam suportar tool calling. Vazio = desligado.
# ATENCAO: na camada gratuita o Google pode usar o conteudo enviado para melhorar os
# produtos deles - as mensagens do seu servidor passam a sair para o Google nesse caso.
GOOGLE_API_KEY=
GOOGLE_MODELS=gemini-3.5-flash-lite

# --- Imagens ---

# Antes de enviar, a imagem e reduzida a esse lado maior e recomprimida em JPEG. Uma
# foto de celular sai de ~11 MB para ~0,2 MB sem perda util de conteudo. 0 desliga.
# Atencao ao custo no Gemini: ele cobra 258 tokens quando AMBOS os lados sao <= 384px,
# e a partir dai cobra por ladrilho - 4 ladrilhos (1032 tokens) para qualquer imagem
# maior em 4:3. Ou seja, 1024, 768 e 512 custam o mesmo; so 384 e mais barato, ao
# preco de perder detalhe.
VISION_MAX_IMAGE_PX=1024
VISION_JPEG_QUALITY=85

# OCR local com Tesseract: le o texto da imagem sem mandar nada para fora. Precisa do
# binario tesseract-ocr (ja incluso no Dockerfile); faltando ele, o OCR se desliga.
OCR_ENABLED=true
OCR_LANGS=por+eng
# Minimo de caracteres para considerar que a imagem "e texto".
OCR_MIN_CHARS=24
# Tendo lido texto suficiente localmente, nao manda a imagem para o modelo de visao.
OCR_SKIPS_VISION=true

# Ultimo recurso quando o OCR nao resolve (foto, meme, grafico): usar o modelo de
# visao. Com false, nenhuma imagem sai da maquina - o bot avisa que nao enxergou.
VISION_ENABLED=true

# Como a visao e usada. true (padrao): o modelo de visao so DESCREVE a imagem, com um
# prompt de ~70 tokens, e o modelo de texto redige a resposta a partir dessa descricao.
# Sai ~60% mais barato (o system prompt e o historico nao sobem junto), o provedor de
# visao nao ve a conversa, e a resposta mantem persona e ferramentas. false: o modelo
# de visao responde direto, numa chamada so, levando tudo junto.
VISION_DESCRIBE_ONLY=true

# Para processar imagens num modelo local, aponte para um servidor compativel com a
# API da OpenAI (Ollama, LM Studio, llama.cpp) e ajuste VISION_MODEL junto.
# Local : VISION_API_BASE=http://192.168.0.10:11434/v1  + VISION_MODEL=moondream
# Gemini: VISION_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai
#         VISION_API_KEY=<chave de aistudio.google.com/api-key>
#         VISION_MODEL=gemini-3.5-flash-lite
# Vazio = usa o OpenRouter. A chave e opcional (servidor local costuma nao pedir).
VISION_API_BASE=
VISION_API_KEY=

# Quantas mensagens recentes (usuario+bot) vao inteiras para o modelo. As mais antigas
# viram um resumo automatico em vez de sumir.
MEMORY_MAX_MESSAGES=40

# Limite de caracteres de uma resposta antes de ser cortada (num ponto limpo, fim
# de frase/paragrafo) para evitar respostas em forma de texto enorme numa mensagem
# so. O limite tecnico do Discord (2000 caracteres) sempre se aplica por cima disso.
# E um teto de seguranca, nao o tamanho desejado: quem mantem a resposta curta e o
# prompt. Baixar demais faz resposta tecnica boa chegar cortada pela metade.
MAX_REPLY_CHARS=1700

# Quantos fatos de longo prazo (memoria que sobrevive ao `reset`) o bot guarda por
# canal. Cheio, o bot para de memorizar fatos novos ate alguem que modera abrir espaco
# com `esquecer` (com o prefixo de COMMAND_PREFIX).
MAX_FACTS_PER_CHANNEL=80

# Quantos fatos uma mesma pessoa pode ter criado no canal, para ninguem ocupar sozinha
# todos os espacos de MAX_FACTS_PER_CHANNEL. 0 desliga.
MAX_FACTS_PER_AUTHOR=15

# Quantas mensagens do canal em que o bot NAO foi chamado ele guarda como contexto,
# so para saber do que se estava falando quando finalmente for chamado. Use 0 para
# desligar completamente (o bot deixa de guardar mensagens nao direcionadas a ele).
AMBIENT_CONTEXT_MESSAGES=12

# Respostas longas saem em mensagens separadas (quebrando nos paragrafos) com pausa
# de digitacao entre elas, em vez de um bloco unico - parece mais natural. Use
# false para voltar a mandar tudo numa mensagem.
SPLIT_REPLIES=true
MAX_REPLY_MESSAGES=3

# Velocidade de "digitacao" simulada entre mensagens (caracteres por segundo) e o
# tempo maximo de espera, em segundos.
TYPING_CHARS_PER_SECOND=28
MAX_TYPING_DELAY_SECONDS=2

# Limite de mensagens por pessoa dentro da janela (em segundos). Passou disso, o bot
# avisa uma vez e ignora o resto ate a janela esvaziar. Protege a cota diaria dos
# modelos gratuitos. RATE_LIMIT_MESSAGES=0 desliga.
RATE_LIMIT_MESSAGES=8
RATE_LIMIT_WINDOW_SECONDS=60

# Prefixo dos comandos. Sem espacos. Todas as mensagens do bot mostram os comandos
# ja com este prefixo, entao trocar aqui troca em todo lugar.
COMMAND_PREFIX=o!

# Cargos que, alem de administrador / gerenciar servidor / gerenciar mensagens, podem
# apagar dados do bot (reset e esquecer). Nome ou id, separados por virgula. Em DM a
# restricao nao vale: o dado e da propria pessoa.
ADMIN_ROLES=

# Donos do bot: ids de usuario do Discord (separados por virgula) com todas as permissoes em
# qualquer canal (apagar historico e memoria, forget_fact) e sem limite de mensagens.
# Vazio = o dono padrao de app/config.py. Id se copia com o modo desenvolvedor do Discord.
OWNER_IDS=271256369833836545

# Nomes que acordam o bot num canal sem precisar de @ (separados por virgula).
# Troque pelo nome real do seu bot no Discord - com o nome errado aqui, chamar pelo
# nome simplesmente nao funciona.
BOT_NAMES=orionai,orion

# Depois de responder alguem, o bot continua a conversa com essa mesma pessoa sem
# exigir @ novamente por esse tempo (segundos). O relogio reinicia a cada resposta
# dele, entao e tempo de silencio, nao duracao total da conversa. Use 0 para exigir
# @ sempre; `parar` (com o prefixo de COMMAND_PREFIX) encerra na hora sem precisar esperar.
FOLLOWUP_WINDOW_SECONDS=15

# Mensagens seguidas da mesma pessoa (ex.: "oi", "tudo bem?", "me ajuda") viram uma resposta
# so: o bot espera esse tempo pela proxima antes de responder. Custo: toda resposta a
# mensagem so de texto fica esse tanto mais lenta. 0 desliga a espera.
BURST_WAIT_SECONDS=2

# Segunda opiniao do Jev (modelo de decisao da TypeSafe no OpenRouter, cobrado por token de
# entrada, bem barato) para o follow-up sem @. Dentro da janela acima, o Jev estima a
# probabilidade da mensagem ser mesmo pro bot; abaixo desse corte o bot fica calado.
# 0 desliga e vale so a janela por tempo. Sugestao para comecar: 0.5. Se a chamada falhar,
# o bot cai no comportamento da janela.
JEV_FOLLOWUP_THRESHOLD=0
JEV_MODEL=typesafe/jev-1.13

# Intencao da mensagem pelo Jev (mesma chamada, cobrada por token de entrada). Com valor
# acima de 0, o Jev classifica o pedido em conversa / busca / link / memoria e o bot so
# oferece ao modelo as ferramentas que fazem sentido (conversa = nenhuma, o que poupa
# idas ao modelo), e tambem estima o tamanho pedido (curta/media/longa) para orientar a
# resposta. O valor e a probabilidade minima da opcao escolhida; abaixo dela o bot segue
# com todas as ferramentas e sem dica. Sugestao: 0.6. 0 desliga.
JEV_INTENT_CONFIDENCE=0

# Jev avalia se a mensagem tenta mudar as regras do bot ou extrair o prompt. Acima do corte
# o codigo anexa um aviso a mensagem antes de ir ao modelo (nao bloqueia nada: e uma dica,
# nao uma defesa). Sugestao: 0.7. 0 desliga.
JEV_INJECTION_THRESHOLD=0

# --- Presenca ("Jogando/Assistindo/Ouvindo ..." embaixo do nome do bot) ---

# Entradas "tipo:texto" separadas por "|", exibidas em rodizio. Tipos: playing,
# watching, listening, competing, custom (e os equivalentes em portugues: jogando,
# assistindo, ouvindo, competindo). Marcadores: {prefix}, {guilds}, {model}. Uma
# entrada cujo numero der zero e pulada. Vazio desliga a presenca.
# Bot nao faz Rich Presence completo: o Discord ignora imagem, botao e party vindos
# de bot, entao so tipo e texto aparecem.
PRESENCE=listening:{prefix}ajuda|watching:{guilds} servidores
PRESENCE_ROTATE_SECONDS=180
# online, idle/ausente, dnd/ocupado, invisible/invisivel
PRESENCE_STATUS=online

# Fuso horario usado para o bot saber a data/hora atual da conversa.
TIMEZONE=America/Sao_Paulo

# Prompt de sistema/personalidade do bot. Blocos fixos sao sempre anexados a isto pelo
# codigo (app/config.py), independente do que for colocado aqui: o tom descontraido (que
# prevalece sobre qualquer instrucao de estilo escrita abaixo), as regras anti-jailbreak,
# as de conversa natural, as de mencao e as de uso da memoria de longo prazo.
# Da para trocar a persona aqui, mas nao para pedir um bot puramente formal: o bloco de
# tom vem depois e vence.
SYSTEM_PROMPT=Voce conversa com as pessoas de um servidor do Discord. Responda em portugues, num tom leve e bem-humorado, como alguem que e boa companhia no chat e por acaso tambem sabe das coisas. Va direto ao ponto - evite texto em excesso quando uma resposta curta resolve; quando o assunto exigir mais detalhe, de o detalhe, usando paragrafos curtos em vez de um bloco unico de texto.