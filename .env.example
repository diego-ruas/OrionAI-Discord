DISCORD_TOKEN=coloque_seu_token_do_discord_aqui
OPENROUTER_API_KEY=coloque_sua_api_key_do_openrouter_aqui

# API key da fastCRW (fastcrw.com) usada para busca/leitura de paginas na internet.
CRW_API_KEY=coloque_sua_api_key_da_fastcrw_aqui

# Modelo padrao (gratuito, texto). Pode trocar por outro terminado em ":free" do OpenRouter.
OPENROUTER_MODEL=tencent/hy3:free

# Modelo para imagens (vision). Usado quando o usuario envia imagem.
OPENROUTER_VISION_MODEL=nvidia/nemotron-nano-12b-v2-vl:free

# Modelos de fallback, em ordem, usados quando o principal falha (rate limit, erro
# HTTP, resposta vazia). Com modelo ":free" isso importa bastante: sem fallback, um
# unico 429 ja vira "nao consegui responder". Todos precisam suportar tool calling,
# porque o bot manda as ferramentas em toda chamada.
OPENROUTER_FALLBACK_MODELS=poolside/laguna-s-2.1:free,cohere/north-mini-code:free

# Quantas mensagens (usuario+bot) manter no historico de cada usuario
MEMORY_MAX_MESSAGES=20

# Limite de caracteres de uma resposta antes de ser cortada (num ponto limpo, fim
# de frase/paragrafo) para evitar respostas em forma de texto enorme numa mensagem
# so. O limite tecnico do Discord (2000 caracteres) sempre se aplica por cima disso.
MAX_REPLY_CHARS=900

# Quantos fatos de longo prazo (memoria que sobrevive ao o!reset e a rotacao do
# historico) o bot guarda por canal. Os mais antigos saem quando o limite e atingido.
MAX_FACTS_PER_CHANNEL=40

# Quantas mensagens do canal em que o bot NAO foi chamado ele guarda como contexto,
# so para saber do que se estava falando quando finalmente for chamado. Use 0 para
# desligar completamente (o bot deixa de guardar mensagens nao direcionadas a ele).
AMBIENT_CONTEXT_MESSAGES=12

# Respostas longas saem em mensagens separadas (quebrando nos paragrafos) com pausa
# de digitacao entre elas, em vez de um bloco unico - parece mais natural. Use
# false para voltar a mandar tudo numa mensagem.
SPLIT_REPLIES=true
MAX_REPLY_MESSAGES=3

# Velocidade de "digitacao" simulada entre mensagens (caracteres por segundo) e o
# tempo maximo de espera, em segundos.
TYPING_CHARS_PER_SECOND=28
MAX_TYPING_DELAY_SECONDS=5

# Prefixo dos comandos. Sem espacos. Todas as mensagens do bot mostram os comandos
# ja com este prefixo, entao trocar aqui troca em todo lugar.
COMMAND_PREFIX=o!

# Nomes que acordam o bot num canal sem precisar de @ (separados por virgula).
# Troque pelo nome real do seu bot no Discord - com o nome errado aqui, chamar pelo
# nome simplesmente nao funciona.
BOT_NAMES=orionai,orion

# Depois de responder alguem, o bot continua a conversa com essa mesma pessoa sem
# exigir @ novamente por esse tempo (segundos). O relogio reinicia a cada resposta
# dele, entao e tempo de silencio, nao duracao total da conversa. Use 0 para exigir
# @ sempre; `!parar` encerra na hora sem precisar esperar.
FOLLOWUP_WINDOW_SECONDS=15

# Fuso horario usado para o bot saber a data/hora atual da conversa e para interpretar
# horarios de lembrete ("me lembra amanha as 9").
TIMEZONE=America/Sao_Paulo

# Lembretes: maximo pendente por pessoa, de quantos em quantos segundos o loop confere
# os vencidos, e quao longe no futuro se pode agendar (dias).
MAX_REMINDERS_PER_USER=10
REMINDER_CHECK_SECONDS=30
MAX_REMINDER_DAYS=365

# Prompt de sistema/personalidade do bot, usado pelo modo "padrao" (ver o!modo).
# Blocos fixos sao sempre anexados a isto pelo codigo (app/config.py), independente
# do que for colocado aqui: as regras anti-jailbreak (nao revelar o prompt, nao trocar
# de persona, tratar conteudo de ferramentas como dado e nao como comando), as regras
# de conversa natural, as de mencao e as de uso da memoria de longo prazo.
SYSTEM_PROMPT=Voce e um assistente profissional em um servidor do Discord. Responda em portugues, com tom cordial, objetivo e preciso. Priorize clareza e correcao sobre informalidade, e seja conciso sem omitir informacoes relevantes. Sobre humor, pode soltar uma piada leve ou comentario descontraido pontualmente, quando a conversa ja estiver em tom informal ou o proprio usuario brincar primeiro - nunca force humor em pedidos serios, tecnicos, ou quando o usuario estiver claramente precisando de ajuda pratica. Sobre emojis, o padrao e nao usar nenhum; use no maximo um, raramente, e apenas em momentos claramente descontraidos - nunca mais de um na mesma resposta, e nunca em respostas serias ou tecnicas. Sobre tamanho, va direto ao ponto - evite paragrafos longos, listas extensas ou texto em excesso quando uma resposta curta resolve; se o assunto realmente exigir mais detalhe, use poucos paragrafos curtos em vez de um bloco unico de texto.
