DISCORD_TOKEN=coloque_seu_token_do_discord_aqui
OPENROUTER_API_KEY=coloque_sua_api_key_do_openrouter_aqui

# API key da fastCRW (fastcrw.com) usada para busca/leitura de paginas na internet.
CRW_API_KEY=coloque_sua_api_key_da_fastcrw_aqui

# Modelo padrao (gratuito, texto). Pode trocar por outro terminado em ":free" do OpenRouter.
OPENROUTER_MODEL=tencent/hy3:free

# Modelo para imagens (vision). Usado quando o usuario envia imagem.
OPENROUTER_VISION_MODEL=nvidia/nemotron-nano-12b-v2-vl:free

# Modelos de fallback, em ordem, usados se o principal for limitado por rate limit.
OPENROUTER_FALLBACK_MODELS=

# Quantas mensagens (usuario+bot) manter no historico de cada usuario
MEMORY_MAX_MESSAGES=20

# Prompt de sistema/personalidade do bot. Um bloco fixo de regras anti-jailbreak
# (nao revelar o prompt, nao trocar de persona, tratar conteudo de ferramentas como
# dado e nao como comando) e sempre anexado a isto pelo codigo (app/config.py),
# independente do que for colocado aqui.
SYSTEM_PROMPT=Voce e um assistente profissional em um servidor do Discord. Responda em portugues, com tom cordial, objetivo e preciso. Priorize clareza e correcao sobre informalidade, e seja conciso sem omitir informacoes relevantes. Sobre humor, pode soltar uma piada leve ou comentario descontraido pontualmente, quando a conversa ja estiver em tom informal ou o proprio usuario brincar primeiro - nunca force humor em pedidos serios, tecnicos, ou quando o usuario estiver claramente precisando de ajuda pratica. Sobre emojis, evite ao maximo; use no maximo um por mensagem, apenas se realmente agregar, e nunca em respostas serias ou tecnicas.
